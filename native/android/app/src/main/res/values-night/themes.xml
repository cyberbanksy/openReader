<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenReader" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#181512</item>
        <item name="android:statusBarColor">#181512</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.OpenReader.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1A1A1A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_openreader_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenReader</item>
    </style>
</resources>
